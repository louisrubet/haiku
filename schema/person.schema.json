{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiku.rubet.fr/schema/person.schema.json",
  "title": "Person",
  "description": "An author or a translator. Source file: people/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "kind": { "enum": ["person", "collective"], "description": "collective: a project or group, e.g. this database." },
    "name": { "type": "string", "minLength": 1, "description": "Usual form, Latin script." },
    "name_original": { "type": "string", "description": "Name in the original script." },
    "born": { "type": "string", "pattern": "^~?\\d{4}(-\\d{2}(-\\d{2})?)?$" },
    "died": {
      "type": "string",
      "pattern": "^~?\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "Required to claim that a person's work is in the public domain."
    },
    "wikidata": { "type": "string", "pattern": "^Q\\d+$" },
    "url": { "type": "string", "format": "uri" }
  },
  "if": { "properties": { "kind": { "const": "person" } } },
  "then": { "required": ["born"] }
}
