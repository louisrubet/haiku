{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haiku.rubet.fr/schema/work.schema.json",
  "title": "Haiku work",
  "description": "One original poem and its translations. Source file: works/<id>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "added", "author", "form", "season", "original", "translations"],
  "properties": {
    "id": { "$ref": "#/$defs/id", "description": "Stable identifier, equal to the file name. Never changes once published." },
    "status": {
      "enum": ["draft", "published", "withdrawn"],
      "description": "Only published works are served. Withdraw rather than delete."
    },
    "added": { "$ref": "#/$defs/date", "description": "Date the work entered the database." },
    "author": { "$ref": "#/$defs/id", "description": "Person id (people/<id>.yaml)." },
    "form": { "enum": ["hokku", "haiku", "senryu", "free-verse-haiku"] },
    "season": { "enum": ["spring", "summer", "autumn", "winter", "new-year", "none"], "description": "Season of the kigo, northern hemisphere." },
    "kigo": { "type": "string", "minLength": 1, "description": "Season word as written in the original." },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "text", "rights"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "text": { "$ref": "#/$defs/text" },
        "romanization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "text"],
          "properties": {
            "language": { "$ref": "#/$defs/language" },
            "text": { "$ref": "#/$defs/text" },
            "system": { "type": "string", "description": "Romanization system, e.g. Hepburn." }
          }
        },
        "composed": { "$ref": "#/$defs/approxDate", "description": "Date of composition, possibly approximate." },
        "first_published": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string" },
            "title_original": { "type": "string" },
            "year": { "$ref": "#/$defs/approxDate" }
          }
        },
        "source_url": { "type": "string", "format": "uri", "description": "Reference edition of the text." },
        "rights": { "$ref": "#/$defs/rights" }
      }
    },
    "translations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "text", "translator", "translated", "rights"],
        "properties": {
          "language": { "$ref": "#/$defs/language" },
          "text": { "$ref": "#/$defs/text" },
          "translator": { "$ref": "#/$defs/id", "description": "Person id (people/<id>.yaml)." },
          "translated": { "$ref": "#/$defs/approxDate" },
          "source": { "type": "string", "description": "Publication the translation comes from." },
          "source_url": { "type": "string", "format": "uri" },
          "notes": { "type": "string" },
          "rights": { "$ref": "#/$defs/rights" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "approxDate": {
      "type": "string",
      "pattern": "^~?\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD; a leading ~ marks an approximate date."
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}-[A-Z][a-z]{3}(-[A-Z]{2})?$",
      "description": "BCP 47 tag with a mandatory script subtag: fr-Latn, ja-Jpan, ja-Latn."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "One verse per line, as set by the author or translator."
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["public-domain", "licensed"] },
        "license": {
          "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0"],
          "description": "SPDX identifier, required when status is licensed."
        },
        "basis": { "type": "string", "description": "Why the text is in the public domain, or who granted the license." },
        "attribution": { "type": "string", "description": "Exact attribution text, required by CC BY licenses." }
      },
      "if": { "properties": { "status": { "const": "licensed" } } },
      "then": { "required": ["license"] },
      "else": { "required": ["basis"] }
    }
  }
}
